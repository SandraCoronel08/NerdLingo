{
  "name": "nerdlingo",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["apps/*"],
  "scripts": {
    "dev:web": "npm run dev --workspace @nerdlingo/web",
    "dev:server": "npm run dev --workspace @nerdlingo/server",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": { "node": ">=20.12.0", "npm": ">=10.0.0" }
}
